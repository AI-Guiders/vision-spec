# DashSpec Studio — vision alignment (leaf scenario)
# Federation cockpit: PFD orient · Forward work · MFD instruments (separate screen)

use aiguiders-mental-model

import <federation/vision/icon-defaults>
import "authoring/registry/*.vision"
import "authoring/components/*.vision"

vision dashspec-studio
  title "DashSpec Studio — report author"

catalog dashspec-studio
defaults
  command.surfaces = palette, ccl.filter
  binding.chord-root = Ctrl+K
  grammar.keyboard.binding = keyboard-key-gesture
end defaults
phrases table
  | name            | phrase               |
  | save-doc        | save active document |
  | open-demo-soak  | open demo_soak       |
  | open-analytics  | open demo_analytics  |
  | focus-preview   | focus preview        |
  | check-project   | check project        |
end phrases
commands table
  | command         | phrase          | help                          |
  | doc.save        | save-doc        | Save active document          |
  | file.open-soak  | open-demo-soak  | Open demo_soak report         |
  | file.open-analytics | open-analytics | Open demo_analytics report |
  | view.preview    | focus-preview   | Focus report preview          |
  | project.check   | check-project   | Check project before save     |
end commands
bindings table
  | gesture | command  |
  | Ctrl+S  | doc.save |
end bindings
end catalog

deck dashspec-studio
preset report-author
  topology (MFD)(F)
  forward editor
  mfd spec-tree
  eicas resolve
end preset
end deck

screen studio
  use-deck report-author
  component editor tabs

screen studio-mfd
  mfd-page
  use-deck report-author
  mfd-tabs Project | SQL | Pad | Preview
  split data-lab
  component spec-tree tree
  component data-lab repl
  component script-pad pad
  component report-preview preview
  component layout-board panel
  component resolve panel

screen command-palette overlay
  component palette command-list

go studio -> command-palette when Ctrl+K
go command-palette -> studio when Escape
go command-palette -> studio when select-command
  then focus editor open selected file

go studio -> studio-mfd when F12
go studio-mfd -> studio when F12

on spec-tree double-click file -> editor
  then open tab and show resolve

end
