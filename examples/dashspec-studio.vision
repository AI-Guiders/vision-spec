# DashSpec Studio — vision alignment
# Federation cockpit: PFD orient · Forward work · MFD instruments (separate screen)
# Preview on 2nd monitor = STUDIO-ADR-0001 prod; sketch uses MFD Preview tab

use aiguiders-mental-model

vision dashspec-studio
  title "DashSpec Studio — report author"

defaults
  icon.library = codicons
end defaults

icon-libraries
  codicons   source npm:@vscode/codicons
end icon-libraries

components dashspec-studio
  table zone
  | id             | kind         | label              |
  | spec-tree      | tree         | Project Browser    |
  | editor         | tabs         | Document editor    |
  | data-lab       | repl         | SQL Browser        |
  | script-pad     | pad          | Script Pad         |
  | report-preview | preview      | Report Preview     |
  | resolve        | panel        | Resolve            |
  | layout-board   | panel        | Layout board       |
  | palette        | command-list | Command palette    |
end components

presentation spec-tree
  label "Project Browser"
  table kind
  | kind         | icon                  | color-token           |
  | folder       | codicons/folder       | tree-folder           |
  | dashspec     | codicons/file-code    | artifact-dashspec     |
  | dashlibrary  | codicons/library      | artifact-dashlibrary  |
  | dashlayout   | codicons/layout       | artifact-dashlayout   |
  | dashdiagram  | codicons/graph        | artifact-dashdiagram  |
  | dashpalette  | codicons/color-mode   | artifact-dashpalette  |
  | dashcatalog  | codicons/list-tree    | artifact-dashcatalog  |
  | sql          | codicons/database     | artifact-sql          |
  | catalog-gdl  | codicons/gear         | artifact-catalog-gdl  |
end presentation

catalog dashspec-studio
defaults
  command.surfaces = palette, ccl.filter
  binding.chord-root = Ctrl+K
  grammar.keyboard.binding = keyboard-key-gesture
end defaults
phrases table
  | name            | phrase               |
  | save-doc        | save active document |
  | open-demo-soak  | open demo_soak       |
  | open-analytics  | open demo_analytics  |
  | focus-preview   | focus preview        |
  | check-project   | check project        |
end phrases
commands table
  | command         | phrase          | help                          |
  | doc.save        | save-doc        | Save active document          |
  | file.open-soak  | open-demo-soak  | Open demo_soak report         |
  | file.open-analytics | open-analytics | Open demo_analytics report |
  | view.preview    | focus-preview   | Focus report preview          |
  | project.check   | check-project   | Check project before save     |
end commands
bindings table
  | gesture | command  |
  | Ctrl+S  | doc.save |
end bindings
end catalog

deck dashspec-studio
preset report-author
  topology (MFD)(F)
  forward editor
  mfd spec-tree
  eicas resolve
end preset
end deck

screen studio
  use-deck report-author
  component editor tabs

screen studio-mfd
  mfd-page
  use-deck report-author
  mfd-tabs Project | SQL | Pad | Preview
  split data-lab
  component spec-tree tree
  component data-lab repl
  component script-pad pad
  component report-preview preview
  component layout-board panel
  component resolve panel

screen command-palette overlay
  component palette command-list

go studio -> command-palette when Ctrl+K
go command-palette -> studio when Escape
go command-palette -> studio when select-command
  then focus editor open selected file

go studio -> studio-mfd when F12
go studio-mfd -> studio when F12

on spec-tree double-click file -> editor
  then open tab and show resolve

fixture spec-tree
  folder planet-repo
    file report.dashspec dashspec
    folder libraries
      file filters.dashlibrary dashlibrary
    folder layouts
      file weekly.dashlayout dashlayout
    folder diagrams
      file peak-kpi.dashdiagram dashdiagram
    folder sql/migrations
      file 001_views.sql sql
      file catalog.gdl catalog-gdl
end fixture

fixture data-lab
  connector demo-db
  schema reports / cards / binds
  repl SELECT COUNT(*) FROM reports
end fixture

fixture script-pad
  prompt create report with sql-server template ulsa-weekly
  plan report.dashspec · filters.dashlibrary · catalog.gdl · 001_views.sql
end fixture

end

